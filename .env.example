# ---------------------------------------------------------------------------
# SoftDealz environment — copy to `.env.local` and adjust.
# Nothing third-party is required: the database is embedded and payments are
# simulated, so this file is all the configuration the app needs.
# ---------------------------------------------------------------------------

# Signs session cookies (HS256). Generate one with:  openssl rand -hex 32
# Required before a production build or start. When unset in development, the
# app generates and stores a local key at data/.auth-secret.
AUTH_SECRET=""

# Absolute URL of the deployment: canonical links, OG images, robots.txt and
# sitemap.xml. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Currency label shown when a record does not carry its own.
NEXT_PUBLIC_CURRENCY="LKR"

# Optional: move the SQLite file (defaults to ./data/softdealz.db) or split the
# secret file from the database directory.
# DATABASE_FILE="./data/softdealz.db"
# AUTH_SECRET_FILE="./data/.auth-secret"
